# =========================
# Dependencies
# =========================
node_modules/

# =========================
# Build output
# =========================
# build/ is electron-builder's buildResources dir: ignore stray build
# output but keep the signing/icon/splash inputs that must be committed.
# These are BUILD INPUTS -- CI packages from a clean checkout, so anything
# electron-builder.yml points at here has to be tracked or the release fails.
build/*
!build/entitlements.mac.plist
!build/icon.icns
!build/icon.png
!build/portable-splash.bmp
dist/
out/
coverage/

# Playwright (E2E) artifacts
test-results/
playwright-report/
blob-report/
.playwright/

# Electron artifacts
*.exe
*.dmg
*.AppImage

# =========================
# Env / secrets
# =========================
.env
.env.*
*.key
*.pem
*.crt

# =========================
# Logs
# =========================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================
# OS
# =========================
.DS_Store
Thumbs.db
Desktop.ini

# =========================
# IDEs
# =========================
# .vscode/settings.json IS tracked, deliberately -- it carries the Action Buttons
# script shortcuts, which are shared tooling rather than personal preference
# (house standard: electron-app-skeleton.md section 3). Everything else under
# .vscode/ is per-user and stays ignored.
.vscode/*
!.vscode/settings.json
.idea/

# =========================
# AI / LLM tools
# =========================
.claude/
.cursor/
.codeium/
.tabnine/
.vscode-chat/
.chatgpt/
.llm/
.ai/

# =========================
# Cache / temp
# =========================
.cache/
tmp/
temp/
*.tmp
*.swp
*.swo
*.tsbuildinfo

# =========================
# Package manager caches
# =========================
.pnpm-store/
.npm/
.yarn/
.yarn-cache/

# =========================
# TypeScript
# =========================
*.tsbuildinfo

# =========================
# Vite
# =========================
node_modules/.vite

# =========================
# Future (monorepo)
# =========================
.turbo/
