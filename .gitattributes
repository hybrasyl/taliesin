# Normalize all text files to LF in the repo. Working copies on Windows
# can still check out as CRLF if the user has core.autocrlf=true, but the
# stored blob is always LF — silences the "LF will be replaced by CRLF"
# warning on commit and prevents mixed line endings from sneaking in.
* text=auto eol=lf

# Binary asset types that may appear under packs/ or test fixtures.
#
# The list exists so classification is stated rather than guessed. Anything not
# named here falls through to `text=auto` above and depends on git's NUL-byte
# heuristic to escape normalization — which works, until it meets a file whose
# first 8000 bytes happen to contain none.
*.png   binary
*.gif   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.bmp   binary
*.ico   binary
*.icns  binary
*.woff  binary
*.woff2 binary
*.dat   binary
*.lod   binary
*.hyb   binary
*.mus   binary
*.mp3   binary
*.ogg   binary
*.wav   binary
*.datf  binary
