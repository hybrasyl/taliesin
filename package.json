{
  "name": "taliesin",
  "productName": "Taliesin",
  "desktopName": "taliesin.desktop",
  "version": "2.12.0",
  "description": "Dark Ages client asset viewer — companion to Creidhne",
  "main": "./out/main/index.js",
  "author": "Caeldeth",
  "homepage": "https://github.com/hybrasyl/taliesin",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "validate": "npm run lint:check && npm run typecheck && npm test",
    "validate:linux": "node scripts/validate-linux.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "npm run build && playwright test",
    "e2e:only": "playwright test",
    "typecheck": "tsc --build",
    "format": "prettier --write .",
    "lint": "eslint . --fix",
    "lint:check": "eslint . --max-warnings 0",
    "start": "electron-vite preview -- --trace-warnings",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:win:portable": "npm run build && electron-builder --win portable",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "fetch-xsd": "node scripts/downloadXSD.js"
  },
  "//dependencies": "Only what the MAIN process requires at run time. electron-builder copies every entry here into app.asar verbatim, while vite already bundles the renderer's libraries into out/renderer -- so a renderer-only package listed here ships twice. Note main reaches several of these through dynamic `await import('pkg')`, which a static `from '...'` grep does not see: dalib-ts, music-metadata, archiver and unzipper are all runtime requirements despite having no static import. See the document repo's ecosystem-rollout-checklist.md R-003.",
  "dependencies": {
    "@eriscorp/dalib-ts": "^3.1.1",
    "@eriscorp/hybindex-ts": "^1.1.0",
    "archiver": "^7.0.1",
    "music-metadata": "^11.12.3",
    "unzipper": "^0.12.3",
    "zod": "^4.3.6"
  },
  "//devDependencies": "@electron/fuses is here for ONE reason: scripts/verify-fuses.test.mjs pins our copied SENTINEL and state bytes against it, and a pin on a transitive dependency is a pin on whatever the tree happens to hoist. app-builder-lib depends on it too and is what actually flips the wire at package time. Nothing imports it at run time -- the verifier reads the artifact with fs.",
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/fuses": "^1.8.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^9.39.4",
    "@fontsource/cinzel": "^5.2.8",
    "@fontsource/cinzel-decorative": "^5.2.8",
    "@fontsource/crimson-pro": "^5.2.8",
    "@mui/icons-material": "^9.1.1",
    "@mui/material": "^9.1.2",
    "@playwright/test": "^1.61.1",
    "@tanstack/react-virtual": "^3.13.23",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/archiver": "^7.0.0",
    "@types/jsdom": "^28.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/xml2js": "^0.4.14",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.5",
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.1",
    "react": "^19.2.7",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.2.7",
    "react-icons": "^5.6.0",
    "simplex-noise": "^4.0.3",
    "typescript": "^5.7.0",
    "vite": "^6.4.1",
    "vitest": "^4.1.2",
    "vitest-canvas-mock": "^1.1.4",
    "xml2js": "^0.6.2",
    "zustand": "^5.0.14"
  }
}
